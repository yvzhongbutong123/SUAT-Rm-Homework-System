{
  "name": "rm-homework",
  "productName": "RoboMaster 战队作业管理",
  "version": "1.0.6",
  "description": "RoboMaster 战队作业管理系统 —— 基于 GitHub 仓库的作业下发、提交、批改与看板",
  "main": "src/main/main.js",
  "author": "RoboMaster Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "selftest": "node tests/selftest.js",
    "icon": "node scripts/gen-icon.js",
    "build": "electron-builder --win portable",
    "build:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  },
  "build": {
    "appId": "com.rmteam.homework",
    "productName": "RMHomework",
    "copyright": "Copyright © 2026 RoboMaster Team",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "RM-Homework-${version}.${ext}"
    },
    "portable": {
      "artifactName": "RM-Homework-${version}.exe",
      "splashImage": null
    },
    "compression": "maximum"
  }
}
